# ─── SERVER ───────────────────────────────────────────────────────────────────

# PostgreSQL connection string (from Supabase: Settings → Database → Connection string)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# Supabase project URL and service role key (Settings → API)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key

# Override the Gemini model (optional, defaults to gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.5-pro

# Comma-separated list of allowed CORS origins (your frontend domain(s))
# Example: ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=https://YOUR_DOMAIN.com

NODE_ENV=development
PORT=5000

# ─── CLIENT (Expo) ────────────────────────────────────────────────────────────
# These must be prefixed with EXPO_PUBLIC_ to be available in the app bundle

# Supabase project URL and anon key (Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# The domain where your Express server is hosted (no trailing slash, no protocol)
# Example: EXPO_PUBLIC_DOMAIN=api.yourdomain.com
EXPO_PUBLIC_DOMAIN=YOUR_API_DOMAIN.com

# PostHog analytics key (optional — leave blank to disable)
# EXPO_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxx
